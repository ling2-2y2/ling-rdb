{
  "name": "@ling2/ling-rdb",
  "version": "1.4.1",
  "description": "Relational database hub for cordis-based hosts: named database registry, migrateRdb versioned DDL runner, MyBatis-Plus-style semantic layer (mbp), a Kysely statement-builder layer (orm), dialect rendering kit, and mysql/postgres/oracle/dm/kingbase provider plugins.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.12.0",
  "author": "ling2-2y2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ling2-2y2/ling-rdb.git"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./orm": {
      "types": "./dist/orm/index.d.ts",
      "import": "./dist/orm/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "database",
    "postgres",
    "mysql",
    "oracle",
    "dameng",
    "kingbase",
    "kysely",
    "migration",
    "mybatis-plus",
    "cordis",
    "orm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:dts": "tsc -p tsconfig.dts-smoke.json",
    "smoke": "node examples/run-all.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "@ling2/ling-coris": "*"
  },
  "dependencies": {
    "dmdb": "1.0.52452",
    "kysely": "0.29.5",
    "mysql2": "^3.11.0",
    "oracledb": "7.0.1",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@ling2/ling-coris": "*",
    "@types/node": "^24.10.1",
    "@types/oracledb": "7.0.3",
    "@types/pg": "8.15.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
